Package: arfun
Type: Package
Title: Ancestral Reconstruction of the Fundamental Niche
Version: 0.3.0
Authors@R:
  c(person(given = "Angel",
           family = "Robles-Fernandez",
           email = "a.l.robles.fernandez@gmail.com",
           role = c("aut", "cre")),
    person(given = "Jorge",
